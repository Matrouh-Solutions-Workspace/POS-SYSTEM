# Cloud API syncing is opt-in and runs only when this app is configured as
# the master device and its local license is valid.
API_SYNC_ENABLED=false

# Exact HTTP endpoint used for batched outbox pushes.
API_SYNC_URL=https://api.example.com/v1/sync/push

# Optional bearer token. The license ID is always sent separately in
# X-License-ID and in the JSON request body.
API_SYNC_TOKEN=

# Private GitHub releases/updater:
# Used by `npm run dist:win:publish` to create/upload release assets.
# Also accepted by the installed master app when set as an OS environment variable.
# Never commit a real token.
GH_TOKEN=

# Optional runtime-only alias for private updater checks on the master device.
# Side devices do not need this; they download updates from the master over LAN.
SHIFT_POS_UPDATE_TOKEN=

# Public license verification key compiled into the Electron main process at build time.
# This must match the private key used by Activation-Site. Public key is not secret.
SHIFT_POS_LICENSE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEA6a1H+875wp9OrSjSzdgsiufVmclxnQlaY5kAHn+Fmio=\n-----END PUBLIC KEY-----"
